# Cloudflare Pages edge caching for the static export.
# Build-hashed assets under /_next/static keep their hash in the URL, so they
# are cacheable forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Public images and videos are reused across pages; cache at the edge for a day.
/awards/*
  Cache-Control: public, max-age=86400
/bentoGrid/*
  Cache-Control: public, max-age=86400
/gallery/*
  Cache-Control: public, max-age=86400
/icons/*
  Cache-Control: public, max-age=86400
/partners/*
  Cache-Control: public, max-age=86400
/sdg/*
  Cache-Control: public, max-age=86400
/team/*
  Cache-Control: public, max-age=86400
/*.png
  Cache-Control: public, max-age=86400
/*.jpg
  Cache-Control: public, max-age=86400
/*.jpeg
  Cache-Control: public, max-age=86400
/*.mp4
  Cache-Control: public, max-age=86400

# HTML pages are re-rendered on every deploy, so a short edge cache keeps them
# fresh while still serving from the closest edge location.
/*
  Cache-Control: public, max-age=60, s-maxage=300